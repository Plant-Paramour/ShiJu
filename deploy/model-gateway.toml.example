# 端点密钥只通过环境变量注入，配置文件不得保存明文 Key。
[[endpoints]]
provider_id = "api-1"
base_url = "https://api.zscc.in/v1" # URL
secret_ref = "SHIJU_LLM_API_1_KEY" # Key 的环境变量名
models = ["deepseek-v3.2-guiji-cc", "deepseek-v4-flash-nv-cc", "Qwen/Qwen3.5-9B", "Qwen/Qwen3.6-27B"]
tier = "primary"
priority = 10
weight = 1
max_concurrency = 8
timeout_seconds = 90
supports_tools = true
supports_stream = true
cost_level = "standard"

