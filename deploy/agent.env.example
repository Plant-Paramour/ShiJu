SHIJU_LLM_BASE_URL=https://provider.example/v1
SHIJU_LLM_API_KEY=replace-with-real-key
SHIJU_LLM_MODEL=provider-model-name
# 配置端点池时改为挂载 deploy/model-gateway.toml.example 的副本。
# SHIJU_MODEL_GATEWAY_CONFIG=/etc/shiju/model-gateway.toml
SHIJU_LLM_TIMEOUT_SECONDS=90
SHIJU_AGENT_MAX_TOOL_ROUNDS=8
SHIJU_POETRY_API_BASE_URL=http://127.0.0.1:8000
SHIJU_AGENT_TOKEN=replace-with-agent-token
SHIJU_WEB_AGENT_ENABLED=true
