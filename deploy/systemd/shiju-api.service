[Unit]
Description=ShiJu control-plane API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=shiju
Group=shiju
WorkingDirectory=/opt/shiju
EnvironmentFile=/etc/shiju/api.env
ExecStart=/opt/shiju/.venv/bin/shiju-api
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
