SHIJU_ENV=production
DATABASE_URL=postgresql://shiju:replace-password@127.0.0.1:5432/shiju
# SQLite 仅供测试/本地开发；生产不使用 SHIJU_DATABASE_PATH。
SHIJU_DATABASE_PATH=/var/lib/shiju/shiju.db
SHIJU_AGENT_TOKEN=replace-with-a-long-random-agent-token
SHIJU_WORKER_TOKEN=replace-with-a-different-long-random-worker-token
SHIJU_AUTH_SECRET=replace-with-a-long-random-auth-secret
SHIJU_MAX_REQUEST_BYTES=65536
SHIJU_WORKER_LEASE_SECONDS=300
SHIJU_AGENT_GLOBAL_CONCURRENCY=32
SHIJU_AGENT_USER_CONCURRENCY=2
SHIJU_AGENT_DAILY_QUOTA=200
